<!DOCTYPE html>
<html>
  <head>
    <title>Melek Soydan Blog</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
      body {
        background-color: #f5f5dc; 
        color: #4b2e1e;
        margin: 0;
        font-family: Tahoma, sans-serif;
      }
      .container {
        width: 80%;
        margin: 20px auto;
        background-color: white;
        border: 2px solid #b22222;
        padding: 20px;
        min-height: 500px;
      }
      .dropdown-item:hover {
  background-color: #b22222 !important;
  color: white !important;
}
    </style>
  </head>

  <body>
    <%= render "shared/navbar" %>

    <div class="container">
      <!-- Okul Bilgisi -->
      <p style="text-align: right; font-size: 11px; color: #b22222; font-weight: bold; margin: 0 0 10px 0;">
        Balıkesir Üniversitesi | Bilgisayar Programcılığı
      </p>

      <%= yield %>
    </div>

    <footer style="text-align: center; padding: 20px; font-size: 12px;">
      © 2026 Melek Soydan 

      <footer style="text-align: center; padding: 20px; font-size: 12px;">
  <%= link_to "Anasayfa", root_path, style: "color: #4b2e1e; text-decoration: none; margin: 0 10px;" %>
  <%= link_to "Kategoriler", categories_path, style: "color: #4b2e1e; text-decoration: none; margin: 0 10px;" %>
  <%= link_to "Hakkımda", "/about", style: "color: #4b2e1e; text-decoration: none; margin: 0 10px;" %>
  <br><br>
  © 2026 Melek Soydan
</footer>
    </footer>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  </body>
</html>