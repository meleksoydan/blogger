
class Post < ApplicationRecord
 
  extend FriendlyId [cite: 241]
  friendly_id :title, use: :slugged [cite: 243]


  has_and_belongs_to_many :categories
  has_one_attached :image
  
 
  has_rich_text :article [cite: 272]

  enum :status, {
    draft: 0,
    published: 1,
    inactive: 2
  }

  normalizes :title, with: ->(title) { title.squish.titlecase }

  validates :title, presence: { message: "Post başlığı boş bırakılamaz." }, 
                    uniqueness: true, 
                    length: { maximum: 100 }
                    
  validates :article, presence: { message: "Post içeriği boş bırakılamaz." }
end
extend FriendlyId
friendly_id :title, use: :slugged

